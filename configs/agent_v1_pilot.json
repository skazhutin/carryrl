{
  "seed": 0,
  "device": "cpu",
  "agent": {
    "pretrained": true,
    "image_size": 224,
    "width": 256,
    "layers": 4,
    "heads": 4,
    "spatial_tokens": 16,
    "memory_tokens": 8,
    "segment_length": 64
  },
  "tasks": [
    "navigation",
    "reaction",
    "mouse",
    "memory",
    "timing",
    "platforming",
    "steering",
    "camera",
    "interaction",
    "causality",
    "key_door",
    "goal_choice",
    "hazards",
    "shooting",
    "ui",
    "chain"
  ],
  "total_rollouts": 32,
  "episodes_per_task": 4,
  "max_episode_steps": 80,
  "env_image_size": 96,
  "n_epochs": 2,
  "learning_rate": 0.0001,
  "weight_decay": 0.01,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "clip_range": 0.2,
  "value_coef": 0.5,
  "entropy_coef": 0.0001,
  "max_grad_norm": 0.5,
  "eval_episodes_per_task": 4,
  "eval_every_rollouts": 4,
  "torch_threads": 4,
  "max_wall_seconds": 1800,
  "reward_bootstrap_episodes_per_task": 8,
  "reward_validation_episodes_per_task": 2,
  "reward_epochs": 40,
  "reward_confidence_threshold": 0.6
}
