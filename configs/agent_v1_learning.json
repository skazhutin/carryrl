{
  "seed": 0,
  "device": "cpu",
  "agent": {
    "pretrained": true,
    "image_size": 224,
    "width": 256,
    "layers": 4,
    "heads": 4,
    "spatial_tokens": 16,
    "memory_tokens": 8,
    "segment_length": 64
  },
  "tasks": [
    "navigation", "reaction", "mouse", "memory", "timing", "platforming", "steering",
    "camera", "interaction", "causality", "key_door", "goal_choice", "hazards", "shooting",
    "ui", "chain"
  ],
  "total_rollouts": 32,
  "episodes_per_task": 2,
  "max_episode_steps": 80,
  "env_image_size": 96,
  "n_epochs": 3,
  "learning_rate": 0.0002,
  "weight_decay": 0.01,
  "gamma": 0.99,
  "gae_lambda": 0.95,
  "clip_range": 0.2,
  "value_coef": 0.1,
  "entropy_coef": 0.0001,
  "max_grad_norm": 0.5,
  "eval_episodes_per_task": 2,
  "eval_every_rollouts": 4,
  "torch_threads": 4,
  "max_wall_seconds": 3600,
  "reward_bootstrap_episodes_per_task": 8,
  "reward_validation_episodes_per_task": 2,
  "reward_epochs": 40,
  "reward_confidence_threshold": 0.6,
  "motor_initialization": "balanced",
  "ppo_minibatch_episodes": 4,
  "ppo_task_balance": true,
  "target_kl": 0.02,
  "eval_stochastic": true,
  "eval_seed": 80001,
  "eval_all_levels": false,
  "evaluate_initial": true,
  "task_episode_multipliers": {"navigation": 4, "reaction": 3, "mouse": 4, "ui": 3},
  "curriculum_difficulty": 0.15,
  "curriculum_warmup_rollouts": 0,
  "visual_config": {
    "mode": "varied",
    "native_sizes": [64, 96, 128],
    "themes": ["slate", "sand", "forest", "violet"],
    "hud_layouts": ["top", "bottom", "left", "right"],
    "textures": true,
    "seed": 0,
    "canvas_padding": 8
  },
  "reward_model_mode": "screen_v2",
  "reward_checkpoint": null,
  "vision_cache_frames": 128
}
